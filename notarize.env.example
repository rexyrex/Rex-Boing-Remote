# Credentials package.sh needs to notarize a release build with Apple.
# Copy this file to notarize.env (which is gitignored) and fill in your own
# values. Never commit notarize.env.
#
# Create an App Store Connect API key at
#   https://appstoreconnect.apple.com/access/integrations/api
# with the Developer role, download the .p8 once, and note the Key ID shown
# next to it and the Issuer ID shown at the top of the page.

# The 10-character Key ID.
ASC_KEY_ID=""

# The Issuer ID (a UUID) for your team.
ASC_ISSUER_ID=""

# Absolute path to the downloaded private key.
ASC_KEY_P8="$HOME/.private_keys/AuthKey_${ASC_KEY_ID}.p8"

# Optional: if you keep the key in fastlane's JSON wrapper instead of a bare
# .p8, point at it here and package.sh extracts the .p8 on first use.
# ASC_KEY_JSON=""
