<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Not sandboxed: the app runs the system's own /usr/bin/ssh with the
	  user's ~/.ssh/config, so jump hosts, agents and hardware keys work as
	  they do in Terminal. It connects only to the servers the user adds.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
